# Upstream revisions selected for the week-one baseline.
# Inspected October 29, 2026; both were upstream HEAD on that date.
# These are a reproducible starting point, not a tested-compatible bundle.
# Sourced by scripts/setup_upstream.sh and scripts/record_provenance.sh.

TIPTOP_URL=https://github.com/tiptop-robot/tiptop.git
TIPTOP_SHA=d8f5afdaa94a7432220c3042f9f80be5ab45aae8

SIM_URL=https://github.com/tiptop-robot/droid-sim-evals.git
SIM_SHA=69a914cf56e0da6adafe9428de39b6ceffe9bcc6

# M2T2 fork used by TiPToP. No SHA was selected in the handoff; setup_upstream.sh
# records whatever it checks out. Set M2T2_SHA to pin it after the first install.
M2T2_URL=https://github.com/williamshen-nz/M2T2.git
M2T2_SHA=96201acdb77baa1bc9d01bdf4d6f870d79b4b696

# Pulled in by `pixi run setup-planners` inside tiptop, not cloned by us.
# cuTAMP is checked out at the tag required by tiptop/utils.py (0.0.6 at TIPTOP_SHA).
# cuRobo is cloned from williamshen-nz/curobo main: record its SHA after install.
EXPECTED_CUTAMP_VERSION=0.0.6
# Recorded from the November 4 A6000 installation. The upstream installer still
# fetches main, so compare its checkout with this SHA after any later reinstall.
CUROBO_SHA=b5fad1df2a3ac4d3e33e369918b7d62d0e59ebd1

# Gemini model. The pinned code defaults to gemini-robotics-er-1.6-preview, which
# Google shut down on Aug 31, 2026. patches/tiptop/0001-gemini-robotics-er-2.patch
# switches it to the documented replacement; see patches/README.md.
UPSTREAM_GEMINI_MODEL=gemini-robotics-er-1.6-preview
EXPECTED_GEMINI_MODEL=gemini-robotics-er-2-preview
